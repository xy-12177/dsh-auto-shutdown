{
  "name": "dsh-auto-shutdown",
  "version": "0.2.1",
  "description": "Automatically shut down DSH with an animated waving whale and a goodbye speech bubble on Windows.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tests/windows/Test-ExitWindow.ps1",
    "test:visuals": "powershell.exe -NoProfile -NonInteractive -STA -ExecutionPolicy Bypass -File tests/windows/Test-RendererVisuals.ps1",
    "preview": "powershell.exe -NoProfile -NonInteractive -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File lib/windows/exit-window.ps1 -Preview"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "windows",
    "shutdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xy-12177/dsh-auto-shutdown.git"
  },
  "homepage": "https://github.com/xy-12177/dsh-auto-shutdown#readme",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
