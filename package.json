{
  "name": "dsh-auto-shutdown",
  "version": "0.1.1",
  "description": "Shut the DSH instance down as soon as the web UI disconnects.",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "windows",
    "shutdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xy-12177/dsh-auto-shutdown.git"
  },
  "homepage": "https://github.com/xy-12177/dsh-auto-shutdown#readme",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
